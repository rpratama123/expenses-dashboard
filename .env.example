# Copy to .env and set this to the exact HTTPS origin exposed by NPM.
PUBLIC_ORIGIN=https://expenses.example.com

# Build and runtime identity. It must own the appdata directory and be able to
# traverse/read the incoming directory.
PUID=99
PGID=100

# Existing external Docker network shared with Nginx Proxy Manager.
NPM_NETWORK=proxynet
IMAGE_TAG=local

POLL_SECONDS=30
FX_POLL_SECONDS=3600
REPORT_TIMEZONE=Asia/Jakarta
MAX_IMPORT_BYTES=536870912
SNAPSHOT_RETENTION=2
